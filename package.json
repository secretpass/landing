    "next": "16.3.5",
    "posthog-js": "^1.438.9",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-shiki": "^0.11.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.2",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "tailwindcss": "^4",
    "typescript": "^6",
    "wrangler": "^4.156.0"
